{
  "dependencies": {
    "@tailwindcss/cli": "^4.1.4",
    "concurrently": "^9.1.2",
    "live-server": "^1.2.2",
    "tailwindcss": "^4.1.4"
  },
  "scripts": {
    "dev": "npx @tailwindcss/cli -i ./src/input.css -o ./src/output.css --watch",
    "live-server": "live-server --port=3000",
    "nra": "npm-run-all --parallel dev live-server",
    "concur": "concurrently \"npm run dev\" \"npm run live-server\""
  },
  "devDependencies": {
    "install": "^0.13.0",
    "npm": "^11.3.0",
    "npm-run-all": "^4.1.5"
  }
}
